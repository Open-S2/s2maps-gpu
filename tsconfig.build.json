{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["DOM", "DOM.Iterable", "ESNext", "WebWorker"],
    "checkJs": false,
    "strictNullChecks": true,
    "outDir": "dist",
    "declarationDir": "dist",
    "declaration": true,
    "skipLibCheck": true,
    "noEmit": false,
    "module": "Preserve",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "allowSyntheticDefaultImports": true,
    "types": ["@webgpu/types"],
    // "baseUrl": "s2", // This must be specified if "paths" is.
    "rootDir": "s2",
    "paths": {
      "*": ["./*"],
      "s2maps-gpu/*": ["./s2/*"],
      "s2/*": ["./s2/*"],
      "config/*": ["./config/*"],
      "gis-tools/*": ["./s2/gis-tools/*"],
      "dom/*": ["./s2/render/dom/*"],
      "gl/*": ["./s2/render/gl/*"],
      "gpu/*": ["./s2/render/gpu/*"],
      "plugins/*": ["./s2/plugins/*"],
      "source/*": ["./s2/source/*"],
      "style/*": ["./s2/style/*"],
      "ui/*": ["./s2/ui/*"],
      "util/*": ["./s2/util/*"],
      "workers/*": ["./s2/workers/*"]
    }
  },
  "ts-node": {
    "esm": true,
    "experimentalSpecifierResolution": "node"
  },
  "include": ["types/*.d.ts", "s2/**/*.ts"]
}
