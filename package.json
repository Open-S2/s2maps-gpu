{
  "name": "s2maps-gpu",
  "type": "module",
  "version": "0.18.0",
  "description": "S2 Maps GPU - An open source, high-performance, and GPU-accelerated map engine for rendering large-scale, interactive maps.",
  "keywords": [
    "s2",
    "s2-geometry",
    "maps",
    "cartography",
    "gpu",
    "webgpu",
    "webgl2",
    "webgl",
    "digital",
    "mapping",
    "engine"
  ],
  "homepage": "https://opens2.com/s2maps-gpu",
  "bugs": {
    "url": "https://github.com/Open-S2/s2maps-gpu/issues"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/Open-S2"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/Open-S2/s2maps-gpu.git"
  },
  "scripts": {
    "build:S2": "bun build:ESM && bun ./configS2/buildWebpack.ts",
    "build:S2:flat": "bun run configS2/buildBunFlat.ts",
    "build:ESM": "rm -rf dist && tsc --project tsconfig.dist.json --jsx react-jsx",
    "build:frameworks": "vite build --config frameworks/vite.config.ts",
    "dev": "vite --config vite.serve.config.ts --host",
    "docs": "typedoc --tsconfig tsconfig.typedoc.json",
    "lint:S2": "oxlint s2",
    "loc": "tokei ./s2 # && tokei ./rust",
    "test:clean": "rm -rf .nyc_output coverage && mkdir .nyc_output && mkdir coverage",
    "test:server": "bun run ./tests/server.ts",
    "test:vitest": "vitest run --coverage",
    "test:vitest:server": "concurrently -k -r -i --success=first \"bun test:server\" \"bun test:vitest\"",
    "test:playwright": "playwright test -c ./tests-playwright/playwright.config.ts && nyc report",
    "test:playwright:ui": "playwright test --ui -c ./tests-playwright/playwright.config.ts",
    "test:playwright:server": "bun run ./tests-playwright/server.ts",
    "test:all": "bun run test:clean && bun run test:playwright",
    "test:all:vitest": "bun run test:clean && bun run test:vitest:server",
    "prepare:toAdd": "bun run lint:S2 && bun run build:ESM && bun run build:frameworks"
  },
  "files": [
    "dist",
    "frameworks/dist"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./frameworks": {
      "import": "./frameworks/dist/index.js",
      "types": "./frameworks/dist/index.d.ts"
    },
    "./plugins": {
      "import": "./dist/plugins.js",
      "types": "./dist/plugins.d.ts"
    },
    "./polyfills": {
      "import": "./dist/polyfills.js",
      "types": "./dist/polyfills.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist-types/index.d.ts",
  "dependencies": {
    "earclip": "^1.2.1",
    "open-vector-tile": "^1.12.0",
    "unicode-shaper": "0.7.0"
  },
  "devDependencies": {
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@maplibre/maplibre-gl-style-spec": "^26.1.0",
    "@nuxt/content": "^3.15.0",
    "@playwright/experimental-ct-vue": "1.61.1",
    "@playwright/test": "1.61.1",
    "@rollup/pluginutils": "^5.4.0",
    "@sveltejs/adapter-auto": "^7.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "@types/mapbox-gl": "^3.5.0",
    "@types/maplibre-gl": "^1.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/webpack": "^5.28.5",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/web-worker": "^4.1.10",
    "@webgpu/types": "^0.1.71",
    "ajv": "^8.20.0",
    "better-sqlite3": "^12.11.1",
    "compression-webpack-plugin": "^12.0.0",
    "concurrently": "^10.0.3",
    "coveralls": "^3.1.1",
    "css-loader": "^7.1.4",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "esbuild": "^0.28.1",
    "esbuild-loader": "^4.5.0",
    "eslint": "^10.7.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^63.0.13",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-svelte": "^3.20.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "eslint-plugin-vue": "^10.9.2",
    "filesize": "^11.0.22",
    "find-cache-directory": "^6.0.0",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "lcov-result-merger": "^6.0.0",
    "mini-css-extract-plugin": "^2.10.2",
    "nyc": "^18.0.0",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "picocolors": "^1.1.1",
    "raw-loader": "^4.0.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "s2-tilejson": "^1.14.0",
    "s2json-spec": "^1.12.2",
    "svelte": "^5.56.5",
    "svgo": "^4.0.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-coverage": "^4.0.3",
    "typedoc-plugin-mdn-links": "^5.1.1",
    "typedoc-plugin-vue": "^1.5.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.64.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.1.0",
    "v8-to-istanbul": "^9.3.0",
    "vite": "^8.1.4",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-eslint2": "^5.3.0",
    "vite-plugin-istanbul": "^9.0.1",
    "vite-plugin-svelte": "^3.0.1",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.10",
    "vitest-browser-vue": "^2.1.0",
    "vue": "^3.5.39",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.1.0",
    "webpack": "^5.108.4",
    "webpack-bundle-analyzer": "^5.3.1",
    "webpack-stats-viewer-plugin": "^1.1.1"
  },
  "license": "SEE LICENSE FILE"
}
